Options -Indexes
RewriteEngine On

# Jeśli plik lub katalog fizycznie istnieje — serwuj bez zmian
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Usuń .html z URL (301 redirect gdy ktoś wejdzie z .html)
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# Wewnętrznie mapuj /strona → /strona.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]
