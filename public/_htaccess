# Turn Rewrite Engine On
RewriteEngine on
RewriteCond ${REQUEST_URI} ^.+$
RewriteCond %{REQUEST_FILENAME} \.(gif|jpe?g|png|js|css|swf|php|ico|txt|pdf|xml)$ [OR]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -l
RewriteRule ^ - [L]

RewriteRule cennik cennik.html
RewriteRule o-nas o-nas.html
RewriteRule kontakt kontakt.php
RewriteRule udraznianie udraznianie.html
RewriteRule monitoring monitoring.html
RewriteRule prace-wewnetrzne prace-wewnetrzne.html
RewriteRule prace-zewnetrzne prace-zewnetrzne.html
RewriteRule serwis-instalacji serwis.html
RewriteRule ozonowanie ozonowanie.html
RewriteRule doradztwo doradztwo.html
